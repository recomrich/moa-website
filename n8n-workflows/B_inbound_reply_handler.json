      "id": "b001",
      "name": "Webhook - Inbound Message",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "parameters": {
        "path": "inbound-reply",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "b002",
      "name": "Code - Normalize Inbound",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "jsCode": "// Normalise SMS (Twilio), WhatsApp (Twilio), ou Email\nconst body = $input.first().json.body || $input.first().json;\nconst channel = body.channel || (body.From?.includes('whatsapp') ? 'whatsapp' : body.To ? 'sms' : 'email');\n\nlet sender_phone = null;\nlet sender_email = null;\nlet message_text = '';\n\nif (channel === 'sms' || channel === 'whatsapp') {\n  sender_phone = (body.From || '').replace('whatsapp:', '');\n  message_text = body.Body || '';\n} else if (channel === 'email') {\n  sender_email = body.from || body.sender || '';\n  message_text = body.text || body.subject || '';\n}\n\nreturn [{\n  json: {\n    channel,\n    sender_phone,\n    sender_email,\n    message_text: message_text.trim(),\n    raw: body\n  }\n}];"
      }
    },
    {
      "id": "b003",
      "name": "PostgreSQL - Lookup Active Mission",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        750,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "pg-creds",
          "name": "PostgreSQL ATS DB"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT m.id AS mission_id, m.ats_mission_id, m.mission_date, m.start_time, m.location,\n       m.skill_required, m.status, m.recruiter_id,\n       c.id AS candidate_id, c.name AS candidate_name, c.phone, c.email,\n       r.email AS recruiter_email, r.slack_user_id AS recruiter_slack\nFROM missions m\nJOIN candidates c ON c.id = m.ats_candidate_id\nLEFT JOIN recruiters r ON r.id = m.recruiter_id\nWHERE (\n  ('{{ $json.sender_phone }}' != '' AND c.phone = '{{ $json.sender_phone }}')\n  OR\n  ('{{ $json.sender_email }}' != '' AND c.email = '{{ $json.sender_email }}')\n)\nAND m.status NOT IN ('COMPLETED_PRESENT','COMPLETED_ABSENT','COMPLETED_LATE','DECLINED')\nAND m.mission_date >= CURRENT_DATE\nORDER BY m.mission_date ASC\nLIMIT 1;",
        "options": {}
      }
    },
    {
      "id": "b004",
      "name": "IF - Mission Found",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c01",
              "leftValue": "={{ $json.mission_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "b005",
      "name": "Code - Classify Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1250,
        200
      ],
      "parameters": {
        "jsCode": "const text = ($input.first().json.message_text || '').toUpperCase().trim();\nconst missionData = $input.first().json;\n\nconst YES_PATTERNS = ['OUI', 'YES', 'OK', 'CONFIRME', 'CONFIRMÉ', 'D ACCORD', 'D\\'ACCORD', 'DACCORD', 'PRESENT', 'PRÉSENT', '1'];\nconst NO_PATTERNS = ['NON', 'NO', 'REFUSE', 'REFUSÉ', 'IMPOSSIBLE', 'PAS DISPONIBLE', 'INDISPONIBLE', '0', 'ANNULE', 'ANNULÉ'];\nconst STOP_PATTERNS = ['STOP', 'DESINSCRIPTION', 'DÉSABONNER', 'UNSUBSCRIBE', 'CANCEL'];\n\nlet classification = 'UNCLEAR';\n\nif (STOP_PATTERNS.some(p => text.includes(p))) {\n  classification = 'STOP';\n} else if (YES_PATTERNS.some(p => text === p || text.startsWith(p + ' ') || text.startsWith(p + ','))) {\n  classification = 'YES';\n} else if (NO_PATTERNS.some(p => text === p || text.startsWith(p + ' ') || text.startsWith(p + ','))) {\n  classification = 'NO';\n}\n\nreturn [{\n  json: {\n    ...missionData,\n    classification,\n    message_text: $input.first().json.message_text\n  }\n}];"
      }
    },
    {
      "id": "b006",
      "name": "Switch - Route by Classification",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        1500,
        200
      ],
      "parameters": {
        "mode": "rules",
        "options": {},
        "rules": {
          "rules": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.classification }}",
                    "rightValue": "YES",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "YES"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.classification }}",
                    "rightValue": "NO",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "NO"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.classification }}",
                    "rightValue": "UNCLEAR",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "UNCLEAR"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.classification }}",
                    "rightValue": "STOP",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "STOP"
            }
          ]
        }
      }
    },
    {
      "id": "b007",
      "name": "PG - Set CONFIRMED",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        1750,
        100
      ],
      "credentials": {
