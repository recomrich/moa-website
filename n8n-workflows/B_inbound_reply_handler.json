            },
            {
              "name": "Body",
              "value": "=Merci {{ $json.candidate_name }}, votre présence est bien confirmée pour le {{ $json.mission_date }} à {{ $json.location }}. À bientôt !"
            }
          ]
        },
        "options": {}
      }
    },
    {
