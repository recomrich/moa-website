        "sendBody": true,
        "contentType": "json",
        "options": {},
        "specifyBody": "string",
        "jsonBody": "={{ JSON.stringify({ text: `✅ *Confirmation reçue* — ${$json.candidate_name} a CONFIRMÉ la mission du ${$json.mission_date} (${$json.location}). Ref: ${$json.ats_mission_id}` }) }}"
      }
    },
