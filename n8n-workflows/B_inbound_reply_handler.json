      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE missions SET status = 'CONFIRMED', confirmed_at = NOW(), updated_at = NOW()\nWHERE id = {{ $json.mission_id }};",
        "options": {}
      }
    },
